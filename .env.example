# Variables de entorno para CV Analytics
# Copiar este archivo a .env y configurar los valores reales.
# .env está en .gitignore y NUNCA debe subirse al repositorio.

# ============================================
# Base de datos PostgreSQL
# ============================================
# Ninguna de estas tiene valor por defecto: si falta una, `docker compose up`
# falla en el acto. Es deliberado. Un DB_HOST con valor por defecto apuntando
# a un contenedor inexistente dejó el servicio en bucle de reinicio sin que
# nadie se enterara.
#
# DB_HOST es el NOMBRE DEL CONTENEDOR de PostgreSQL, no un hostname de red.
# Compruébalo antes de rellenarlo, rara vez es el que uno recuerda:
#     docker ps --format '{{.Names}}' | grep -i postgres
#
# Y ese contenedor tiene que compartir una red Docker con analytics-api
# (ver la clave `networks` de docker-compose.yaml):
#     docker inspect <contenedor> --format '{{json .NetworkSettings.Networks}}'
DB_HOST=
DB_PORT=5432

# Base y usuario dedicados, no el superusuario `postgres`: así una brecha en
# la API de analytics no alcanza al resto del clúster.
# Ver database/create-analytics-role.sql
DB_NAME=
DB_USER=
DB_PASSWORD=

# ============================================
# Acceso al dashboard y a la API de estadísticas
# ============================================
# Protegen GET /api/analytics, GET /api/analytics/recent y GET /analytics.
# Genera una contraseña larga y aleatoria:
#     openssl rand -base64 32
ANALYTICS_USER=
ANALYTICS_PASSWORD=

# ============================================
# Privacidad
# ============================================
# Sal secreta para el hash de las IPs de visitantes. Las IPs nunca se
# almacenan en claro; se guardan la red truncada y este hash.
# Genérala una sola vez y NO la cambies después: si cambia, se pierde la
# continuidad del conteo de visitantes únicos.
#     openssl rand -hex 32
ANALYTICS_IP_SALT=
