# Environment variables
.env
.env.local
# El stack local: .env.dev.example sí se versiona, el .env.dev de cada uno no.
.env.dev

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/venv/

# Docker
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backup files
# Nota: .gitignore NO desrastrea lo que ya estaba en git.
# Estos backups se movieron a .backups/ y se desrastrearon con `git rm --cached`.
*-old.*
*.bak
.backups/

# Configuración local de Claude Code (contiene rutas absolutas de la máquina)
.claude/settings.local.json

# Capturas de pantalla sueltas en la raíz. Van y vienen para enseñar algo
# puntual y no son parte del proyecto; dashboard.png se coló así dentro de un
# commit de documentación. Anclado a la raíz a propósito: las imágenes del
# sitio viven en src/assets/images/ y esas sí se versionan.
/*.png
/*.jpg
/*.jpeg

# Tests de extremo a extremo (tools/e2e). El código sí se versiona; el
# navegador que descarga Playwright y sus informes, no.
tools/e2e/node_modules/
tools/e2e/test-results/
tools/e2e/playwright-report/
