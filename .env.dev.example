# Configuración para el stack local (docker-compose.dev.yaml).
#
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yaml --env-file .env.dev up --build
#
# Todos los valores tienen un valor por defecto razonable en el propio compose,
# así que este fichero solo hace falta si quieres cambiar alguno. NO son
# secretos: son credenciales de una base de datos que vive en tu portátil.
#
# El .env de producción es otro fichero, está en .gitignore y ahí sí lo son.

DB_NAME=cv
DB_USER=cv
DB_PASSWORD=cv-local

ANALYTICS_USER=admin
ANALYTICS_PASSWORD=admin-local
ANALYTICS_IP_SALT=sal-de-desarrollo

ANALYTICS_DISPLAY_TZ=America/Caracas
LOG_LEVEL=DEBUG

# Puertos publicados en el host. Cámbialos si alguno está ocupado; el error de
# Docker cuando chocan no dice qué servicio es.
PUERTO_CV=8080
PUERTO_API=8000
PUERTO_POSTGRES=55432
